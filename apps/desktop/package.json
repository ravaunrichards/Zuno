{
  "name": "@zuno/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Hardened Electron shell for ZUNO's web client",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.zuno.desktop",
    "productName": "ZUNO",
    "files": ["main.cjs", "preload.cjs", "../web/**/*", "!../web/gifts.json"],
    "directories": { "output": "release" },
    "linux": { "target": ["AppImage"] },
    "win": { "target": ["nsis"] },
    "mac": { "target": ["dmg"] }
  }
}
