{
  "name": "@zuno/desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Hardened Electron shell for ZUNO's web client",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^42.11.16",
    "electron-builder": "^26.15.0"
  },
  "build": {
    "appId": "com.zuno.desktop",
    "productName": "ZUNO",
    "files": [
      "main.cjs",
      "preload.cjs",
      "../web/**/*",
      "!../web/gifts.json"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  }
}
