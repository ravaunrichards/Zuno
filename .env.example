# ZUNO environment — descriptive names only. NEVER commit real secrets.
# Copy to .env and fill with your own credentials. Production stays DISABLED
# until every provider value below is set and verified.

# ---- Runtime ----
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
API_PORT=4000
# Optional public web/API origin and trusted CORS origins.
ZUNO_PUBLIC_API_BASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002
SUPABASE_MEDIA_BUCKET=zuno-media
MEDIA_SIGNED_URL_TTL_SECONDS=600
RANKING_RESET_TZ=America/Jamaica

# ---- Supabase (integrations/supabase) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side ONLY. Never bundle into web/mobile/desktop clients.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ---- LiveKit (integrations/livekit) ----
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WEBHOOK_KEY=

# ---- PayPal Developer (integrations/paypal) ----
PAYPAL_ENV=sandbox            # sandbox | live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PAYOUTS_ENABLED=false

# ---- Render (infrastructure/render) ----
RENDER_API_KEY=

# ---- Feature flags ----
FEATURE_PRODUCTION_PAYMENTS=false
FEATURE_PAYOUTS=false
FEATURE_LIVE_RECORDING=false
