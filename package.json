{
  "name": "zuno",
  "version": "0.2.0",
  "private": true,
  "description": "ZUNO — unified global social, entertainment, communication, livestreaming, commerce and creator ecosystem.",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "backend/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "check:env": "node scripts/check-env.js",
    "typecheck": "node scripts/lint.js",
    "lint": "node scripts/lint.js",
    "format": "node scripts/lint.js",
    "test": "node scripts/run-tests.js",
    "test:unit": "node scripts/run-tests.js",
    "test:integration": "node scripts/run-tests.js",
    "test:e2e": "node scripts/run-tests.js",
    "test:security": "node scripts/run-tests.js",
    "gifts:generate": "python3 scripts/generate_gifts.py",
    "assets:validate": "node scripts/validate-assets.js",
    "db:validate": "node scripts/validate-db.js",
    "verify": "node scripts/verify.js",
    "build": "node scripts/build.js",
    "build:web": "node scripts/build-web.js",
    "package": "node scripts/package.js",
    "platforms:validate": "node scripts/validate-platforms.js",
    "db:test": "bash scripts/test-migrations.sh"
  },
  "devDependencies": {
    "turbo": "^1.13.0",
    "typescript": "^5.4.0"
  },
  "pnpm": {
    "overrides": {
      "tar@<=7.5.20": "^7.5.21",
      "extract-zip": "npm:@electron-internal/extract-zip@1.0.6"
    }
  }
}
